@export var points_per_hit: int = 1@export var hit_tween_time: float = 0.10@export var hit_rotation_degrees: float = 8.0@export var hit_scale_factor: float = 1.08

func _ready() -> void:if has_node(“Area2D”):$Area2D.input_pickable = true$Area2D.connect(“input_event”, Callable(self, “_on_area_input_event”))

func _on_area_input_event(viewport, event, shape_idx) -> void:if event is InputEventMouseButton and event.pressed and event.button_index == MouseButton.LEFT:emit_signal(“hit”, points_per_hit)_play_hit_animation()if has_node(“AudioStreamPlayer2D”):$AudioStreamPlayer2D.play()

func _play_hit_animation() -> void:var orig_scale = scalevar orig_rot = rotation_degreesvar tw = create_tween()tw.set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)# escalado y rotación rápida y vueltatw.tween_property(self, “scale”, orig_scale * hit_scale_factor, hit_tween_time)tw.tween_property(self, “scale”, orig_scale, hit_tween_time)tw.tween_property(self, “rotation_degrees”, hit_rotation_degrees, hit_tween_time)tw.tween_property(self, “rotation_degrees”, orig_rot, hit_tween_time)